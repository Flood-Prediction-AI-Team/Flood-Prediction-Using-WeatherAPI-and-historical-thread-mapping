{
  "version": 2,
  "builds": [
    {
      "src": "backend.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "public/**",
          "Merged_dataset/fused_historical_database.csv",
          "flood_model.pkl"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "backend.py"
    }
  ]
}